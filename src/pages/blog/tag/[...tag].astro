---
import AdSlot from "@/components/AdSlot.astro";
import ListaPosts from "@/components/ListaPosts.astro";
import { getPosts } from "@/lib/blog";
import Layout from "@/layouts/layout.astro";
import { nombreOg } from "@/lib/og";

export async function getStaticPaths() {
  const posts = await getPosts();

  const uniqueTags = [
    ...new Set(
      posts.flatMap((post) => post.data.tags.map((tag) => tag.toLowerCase())),
    ),
  ];

  return uniqueTags.map((tag) => ({
    params: { tag },
  }));
}

const posts = await getPosts();

const { tag } = Astro.params;
const normalizedTag = tag.toLowerCase();

const filteredPosts = posts.filter((post) =>
  post.data.tags.map((t) => t.toLowerCase()).includes(normalizedTag),
);

const metadata = {
  title: `Posts con la etiqueta ${tag} | Comi Dólar`,
  description: {
    meta: `Posts con la etiqueta '${tag}' en el blog oficial de Comi Dólar.`,
    og: `Posts con la etiqueta '${tag}' en el blog oficial de Comi Dólar.`,
  },
  canonical: `https://comidolar.com.ar/blog/tag/${tag}`,
  og: { nombre: `tag-${nombreOg(normalizedTag)}` },
  migas: [["Blog", "/blog"], [`#${normalizedTag}`, `/blog/tag/${tag}`]],
  noindex: true,
};
---

<Layout metadata={metadata}>
  <main class="pagina">
    <h1 class="h1">Posts etiquetados con "{tag}"</h1>
    {filteredPosts.length > 0 ? (
      <ListaPosts posts={filteredPosts} />
    ) : (
      <p class="mt-4">No se encontraron posts con la etiqueta "{tag}".</p>
    )}
    <a class="link" href="/blog">
      Ver todo el blog
    </a>
    <AdSlot ubicacion="blog" />
  </main>
</Layout>
