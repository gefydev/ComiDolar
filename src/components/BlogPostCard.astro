---
import { tituloCorto } from "@/lib/blog";

const { title, description, date, author, theme, tags, slug } = Astro.props;

const fecha = new Date(date).toLocaleDateString("es-AR", {
  timeZone: "America/Argentina/Buenos_Aires",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const enlace = "link min-w-11 justify-center";
---

<article class="caja flex flex-col gap-2 w-full">
  <img
    class="w-full aspect-og object-cover rounded-lg bg-[var(--soft)]"
    src={`/assets/img/opengraph/blog/${slug}.webp`}
    alt=""
    width="1200"
    height="630"
    loading="lazy"
  />
  <h2 class="h2">
    <a class="inline-block py-2" href={`/blog/${slug}`}>
      {tituloCorto(title)}
    </a>
  </h2>
  <p>{description}</p>
  <p class="note">{fecha}</p>
  <p class="flex flex-wrap gap-x-4 text-sm">
    <a class={enlace} href={"/blog/autor/" + author.toLowerCase()}>
      {author}
    </a>
    <a class={enlace} href={"/blog/tema/" + theme.toLowerCase()}>
      {theme}
    </a>
    {tags?.map((tag) => (
      <a class={enlace} href={"/blog/tag/" + tag.toLowerCase()}>
        #{tag}
      </a>
    ))}
  </p>
</article>
