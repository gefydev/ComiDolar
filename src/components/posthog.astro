---
// PostHog: solo visitas y eventos. Sin grabaciones ni encuestas, y recién
// cuando la página terminó de cargar.
---

<script is:inline>
  !(function (w, d) {
    if (w.posthog && w.posthog.__iniciado) return;
    // cola hasta que llegue la librería
    var cola = (w.posthog = []);
    cola.__SV = 1;
    cola.__iniciado = true;
    cola._i = [];
    cola.people = [];
    ["capture", "identify", "register", "reset"].forEach(function (metodo) {
      cola[metodo] = function () {
        cola.push([metodo].concat(Array.prototype.slice.call(arguments)));
      };
    });
    cola.init = function (token, config, nombre) {
      cola._i.push([token, config, nombre]);
    };
    cola.init("phc_ekxNoB33yQfNQenOF0mgUN19Cz80AbjG36yQnMzd2aT", {
      api_host: "https://hog.comidolar.com.ar",
      ui_host: "https://us.posthog.com",
      capture_pageview: "history_change",
      disable_session_recording: true,
      disable_surveys: true,
      disable_external_dependency_loading: true,
      advanced_disable_flags: true,
      capture_heatmaps: false,
      capture_dead_clicks: false,
      capture_performance: false,
      capture_exceptions: false,
    });
    var cargar = function () {
      var s = d.createElement("script");
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src = "https://hog.comidolar.com.ar/static/array.js";
      d.head.appendChild(s);
    };
    var despues = function () {
      if (w.requestIdleCallback)
        w.requestIdleCallback(cargar, { timeout: 5000 });
      else setTimeout(cargar, 2000);
    };
    if (d.readyState === "complete") despues();
    else w.addEventListener("load", despues, { once: true });
  })(window, document);
</script>
