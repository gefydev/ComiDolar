---
import AdSlot from "@/components/AdSlot.astro";
import Layout from "@/layouts/layout.astro";
import FutureCalculator from "@/components/FutureCalculator";

const metadata = {
  title: "Comi Dólar | Tu Futuro",
  description: {
    meta: "Calculá qué materias del CBC de la UBA te corresponden por equivalencia automática al egresar de 5to año en el CNBA o Carlos Pellegrini y comparalo con cursar 6to año.",
    og: "Calculá qué materias del CBC de la UBA te corresponden por equivalencia automática al egresar de 5to año en el CNBA o Carlos Pellegrini y comparalo con cursar 6to año.",
  },
  canonical: "https://comidolar.com.ar/futuro",
  og: { nombre: "futuro" },
  migas: [["Tu Futuro", "/futuro"]],
};
---

<Layout metadata={metadata}>
  <main class="pagina space-y-6">
    <header class="space-y-2">
      <h1 class="h1">Tu Futuro (CBC vs 6to Año)</h1>
      <p class="max-w-[68ch]">
        Según la resolución <strong>RESCS-2026-890-E-UBA-REC</strong>, conocé al
        instante cuántas materias del Ciclo Básico Común ya tenés aprobadas de
        forma automática al egresar de 5to año y compará el camino del CBC
        tradicional con cursar el 6to año optativo.
      </p>
    </header>

    <FutureCalculator client:load />
    <AdSlot ubicacion="interna" />
  </main>
</Layout>
