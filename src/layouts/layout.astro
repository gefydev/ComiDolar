---
const { metadata } = Astro.props;
// Sin `og`, la imagen de la home
const imagenOg = await urlOg(metadata.og?.nombre ?? "home");
const altOg = `${metadata.title.replace(/^Comi Dólar \| | \| (Comi Dólar|comi\.dolar)$| - ComiDolar$/g, "")} · comi.dolar`;
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import PostHog from "@/components/posthog.astro";
import { urlOg } from "@/lib/og";
import { jsonLdMigas, jsonLdSitio, jsonSeguro } from "@/lib/seo";
import "@/styles/global.css";
---

<html lang="es" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metadata.title}</title>
    <link type="image/webp" rel="icon" href="/assets/img/favicon.webp" />
    {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
    <link rel="manifest" href="/manifest.json" />
    <meta name="description" content={metadata.description.meta} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/img/atouch/180.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/assets/img/atouch/152.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href="/assets/img/atouch/120.png"
    />
    <link
      rel="apple-touch-startup-image"
      href="/assets/img/atouch/atouch.png"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ComiDólar Blog"
      href={new URL("rss.xml", Astro.site)}
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="Comi Dólar" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#151515"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="preload" href="/assets/img/appicon_192.png" as="image" />
    <link
      rel="preload"
      href="/fonts/archivo-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // El aviso de instalación puede llegar antes que el resto del código
      window.addEventListener("beforeinstallprompt", function (e) {
        e.preventDefault();
        window.__instalar = e;
        document.dispatchEvent(new Event("instalar:disponible"));
      });
    </script>
    <meta property="og:type" content={metadata.blog ? "article" : "website"} />
    <meta property="og:site_name" content="comi.dolar" />
    <meta property="og:locale" content="es_AR" />
    {metadata.canonical && (
      <meta property="og:url" content={metadata.canonical} />
    )}
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description.og} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altOg} />
    <meta property="fb:app_id" content="3122887071196448" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description.og} />
    <meta name="twitter:image" content={imagenOg} />
    <meta name="twitter:image:alt" content={altOg} />
    <meta name="twitter:site" content="@comidolar" />
    <meta name="twitter:creator" content="@comidolar" />
    {metadata.blog && (
      <>
        <meta name="author" content={metadata.blog.author} />
        <meta name="copyright" content={metadata.blog.copyright} />
        <meta name="date" content={metadata.blog.date} />
        <meta property="article:author" content={metadata.blog.author} />
        <meta property="article:published_time" content={metadata.blog.iso} />
        <meta property="article:section" content={metadata.blog.theme} />
        {metadata.blog.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <script type="application/ld+json" set:html={jsonSeguro(jsonLdSitio())} />
    {metadata.migas && (
      <script
        type="application/ld+json"
        set:html={jsonSeguro(jsonLdMigas(metadata.migas))}
      />
    )}

    {metadata.noindex && <meta name="robots" content="noindex" />}

    <ClientRouter />
    <PostHog />
  </head>
  <body>
    <a class="saltar" href="#contenido">
      Saltar al contenido
    </a>
    <div class="wrap">
      <Header />
      <div id="contenido" tabindex="-1">
        <slot />
      </div>
      <Footer />
    </div>
    <script
      is:inline
      src="/analytics/beacon.min.js"
      data-cf-beacon='{"token": "4536a67fe2714c37845c5aaadcd0f4d2"}'
      defer
    ></script>
    <script>
      import "@/lib/anuncios";
      import "@/lib/transiciones";
    </script>
  </body>
</html>
