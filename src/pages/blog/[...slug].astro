---
import AdSlot from "@/components/AdSlot.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getPosts, tituloCorto } from "@/lib/blog";
import Layout from "@/layouts/layout.astro";
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;
const post: Props = Astro.props;
const { Content } = await render(post);
const {
  data: { description, title, author, date, copyright, theme, tags, hideImage },
} = post;
const slug = post.id;
const jsDate = new Date(date);
const htmlDate = jsDate.toISOString().split("T")[0];
const metadata = {
  title,
  description: {
    meta: description,
    og: description,
  },
  canonical: `https://comidolar.com.ar/blog/${slug}`,
  og: { nombre: `blog-${slug}` },
  migas: [
    ["Blog", "/blog"],
    [tituloCorto(title), `/blog/${slug}`],
  ],
  blog: {
    author,
    date: htmlDate,
    copyright,
    iso: date,
    theme,
    tags,
  },
};
const formattedDate = jsDate.toLocaleString("es-AR", {
  timeZone: "America/Argentina/Buenos_Aires",
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "numeric",
});
---

<Layout metadata={metadata}>
  <main class="pagina angosta markdown">
    {!hideImage && (
      <img
        src={`/assets/img/opengraph/blog/${slug}.webp`}
        width="1200"
        height="630"
        alt={`Post de ComiDolar titulado ${metadata.title}`}
        class="w-full sm:h-[400px] object-cover rounded-[14px]"
      />
    )}
    <Content />
    <footer class="caja mt-8">
      <p class="font-bold">Escrito por {metadata.blog.author}</p>
      <time class="note" datetime={htmlDate}>
        {formattedDate}
      </time>
      <p>
        <a class="link" href="/blog">
          Ver todo el blog
        </a>
      </p>
    </footer>
    <AdSlot ubicacion="blog" />
  </main>
</Layout>
<style is:global>
  .markdown {
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .markdown h1 {
    font-size: 32px;
    line-height: 1.1;
    font-weight: 900;
    font-stretch: 110%;
    margin: 16px 0;
    text-wrap: balance;
  }
  .markdown h2,
  .markdown h3 {
    font-weight: 800;
    line-height: 1.2;
    margin: 32px 0 8px;
  }
  .markdown h2 {
    font-size: 21px;
  }
  .markdown h3 {
    font-size: 18px;
  }
  .markdown p,
  .markdown ul,
  .markdown ol,
  .markdown table,
  .markdown blockquote {
    margin-bottom: 16px;
  }
  .markdown ul {
    list-style: disc;
    padding-left: 20px;
  }
  .markdown ol {
    list-style: decimal;
    padding-left: 20px;
  }
  .markdown blockquote {
    border-left: 4px solid var(--brand);
    padding-left: 16px;
  }
  .markdown > img,
  .markdown p img {
    max-width: 100%;
    height: auto;
  }
  .markdown iframe {
    max-width: 100%;
  }
  .markdown table {
    display: block;
    overflow-x: auto;
  }
</style>
