---
import Layout from "@/layouts/layout.astro";

const metadata = {
  title: "Comi Dólar | Página no encontrada",
  description: {
    meta: "La página que estás buscando no existe en el sitio web de Comi Dólar, la comisión de dólar del Colegio Nacional de Buenos Aires.",
    og: "La página que estás buscando no existe en el sitio web de Comi Dólar, la comisión de dólar del Colegio Nacional de Buenos Aires.",
  },
  og: {
    image: "https://comidolar.com.ar/assets/img/opengraph/404.webp",
    video: "https://comidolar.com.ar/assets/img/opengraph/video.webm",
  },
};
---

<Layout metadata={metadata}>
  <main class="pagina angosta texto">
    <h1 class="h1">La página que estás buscando no existe</h1>
    <p>Puede que la hayamos movido o que el link esté mal escrito.</p>
    <p class="flex flex-wrap gap-3 mt-4">
      <a class="btn" href="/">
        Ver cotizaciones
      </a>
      <a class="btn" href="/calculadora">
        Abrir la calculadora
      </a>
    </p>
  </main>
</Layout>
