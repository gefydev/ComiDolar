---
import Layout from "@/layouts/layout.astro";
import DolarCard from "@/components/DolarCard.astro";
import Lore from "@/components/Lore.astro";
import CarouselElement from "@/components/CarouselElement";
import ArticlePromote from "@/components/ArticlePromote.astro";

import EstadoCotizaciones from "@/components/EstadoCotizaciones.astro";
import { brecha, CASAS, NOMBRES } from "@/lib/cotizaciones";
import { cotizacionesParaRender } from "@/lib/cotizaciones-servidor";

export const prerender = false;

const metadata = {
  title: "Comi Dólar | Comisión de Dólar del CNBA",
  description: {
    meta: "Dólar Blue Hoy. Bienvenidos al sitio oficial de la Comisión de Dólar del Colegio Nacional de Buenos Aires (Comi Dólar). Cotización diaria Dólar Blue y Dólar Oficial.",
    og: "Bienvenidos al sitio oficial de la Comisión de Dólar del Colegio Nacional de Buenos Aires (Comi Dólar). Acá vas a encontrar diariamente la cotización tanto del Dólar Blue como del Dólar Oficial.",
  },
  canonical: "https://comidolar.com.ar",
  og: {
    image: "https://comidolar.com.ar/assets/img/opengraph/home.webp",
    video: "https://comidolar.com.ar/assets/img/opengraph/video.webm",
  },
};

const { cotizaciones, fresco } = await cotizacionesParaRender();
// Con un 5xx, ISR conserva la última versión buena en vez de cachear esta
if (!fresco) Astro.response.status = 503;
const casas = cotizaciones?.casas ?? {};
---

<Layout metadata={metadata}>
  <CarouselElement client:load />
  <main class="space-y-12 mt-12">
    <h1 class="text-zinc-600 dark:text-zinc-300">
      Comi Dólar | Comisión de Dólar del CNBA
    </h1>
    <ArticlePromote />
    <EstadoCotizaciones cotizaciones={cotizaciones} />
    <div
      data-pagina-cotizaciones="home"
      class="flex items-center w-full sm:w-auto flex-wrap gap-6 justify-center"
    >
      {
        CASAS.map((casa) => (
          <DolarCard
            type={casa}
            sell={casas[casa]?.venta ?? null}
            buy={casas[casa]?.compra ?? null}
            date={casas[casa]?.fecha ?? null}
            name={NOMBRES[casa]}
          />
        ))
      }
      <DolarCard
        type="brecha"
        sell={brecha(casas)}
        buy={null}
        date={casas.oficial?.fecha ?? null}
        name="Brecha"
      />
    </div>
    <Lore />
  </main>
</Layout>

<script>
  import { brecha, CASAS } from "@/lib/cotizaciones";
  import { enPagina } from "@/lib/cotizaciones-dom";
  import { formatearFecha } from "@/lib/formato";

  enPagina("home", ({ casas }) => {
    const escribir = (casa: string, campo: string, texto: string) => {
      const el = document.querySelector(
        `[data-casa="${casa}"] [data-campo="${campo}"]`,
      );
      if (el) el.textContent = texto;
    };
    for (const casa of CASAS) {
      const c = casas[casa];
      if (!c) continue;
      escribir(casa, "venta", c.venta.toFixed(2));
      escribir(casa, "compra", c.compra?.toFixed(2) ?? "—");
      escribir(casa, "fecha", `Actualizado: ${formatearFecha(c.fecha)}`);
    }
    const b = brecha(casas);
    if (b === null || !casas.oficial) return;
    escribir("brecha", "venta", `${b.toFixed(2)} %`);
    escribir(
      "brecha",
      "fecha",
      `Actualizado: ${formatearFecha(casas.oficial.fecha)}`,
    );
  });
</script>
