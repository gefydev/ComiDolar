---
import Layout from "@/layouts/layout.astro";
import Lore from "@/components/Lore.astro";

const metadata = {
  title: "Comi Dólar | Grupo de Whatsapp",
  description: {
    meta: "Unite al grupo de Whatsapp de la Comision de Dolar del Colegio Nacional de Buenos Aires para enterarte en vivo de las ultimas novedades!",
    og: "Unite al grupo de Whatsapp de la Comision de Dolar del Colegio Nacional de Buenos Aires para enterarte en vivo de las ultimas novedades!",
  },
  canonical: "https://comidolar.com.ar/whatsapp",
  og: {
    image: "https://comidolar.com.ar/assets/img/opengraph/whatsapp.webp",
    video: "https://comidolar.com.ar/assets/img/opengraph/video.webm",
  },
};
---

<Layout metadata={metadata}>
  <main class="pagina angosta">
    <h1 class="h1">Grupo de WhatsApp</h1>
    <img
      class="w-full max-w-[420px] h-auto my-4"
      alt="Logo de la Comisión de Dólar del Colegio Nacional de Buenos Aires"
      src="/assets/img/wide-c.webp"
      width="512"
      height="256"
    />
    <a
      class="go max-w-[420px]"
      href="https://chat.whatsapp.com/CA29UgWsmr32O0kH6NysG2"
    >
      Unirme al grupo
    </a>
    <div class="texto mt-6">
      <Lore page="whatsapp" />
    </div>
  </main>
</Layout>
