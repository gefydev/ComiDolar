---
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const secciones = [
  { href: "/", nombre: "Cotizaciones" },
  { href: "/calculadora", nombre: "Calculadora" },
  { href: "/blog", nombre: "Blog" },
  { href: "/futuro", nombre: "Tu Futuro" },
  { href: "/whatsapp", nombre: "Grupo" },
];
const actual = (href: string) =>
  href === "/" ? ruta === "/" : ruta === href || ruta.startsWith(href + "/");
---

<header class="top">
  <a class="brand" href="/">
    <img src="/assets/img/appicon_192.png" alt="" width="44" height="44" />
    comi.dolar
  </a>
  <nav class="pills" aria-label="Principal">
    {secciones.map(({ href, nombre }) => (
      <a href={href} aria-current={actual(href) ? "page" : undefined}>
        {nombre}
      </a>
    ))}
  </nav>
  <button class="btn" type="button" data-instalar hidden>
    Instalar
  </button>
</header>

<script>
  import "@/lib/instalar";

  // Con teclado, el navegador no desplaza un link que ya se ve a medias
  document.addEventListener("focusin", (e) => {
    const link = (e.target as Element).closest(".pills a");
    if (link?.matches(":focus-visible"))
      link.scrollIntoView({ block: "nearest", inline: "nearest" });
  });
</script>
