---
// PostHog: solo visitas y eventos. Sin grabaciones ni encuestas, y la librería
// se pide cuando la página terminó de cargar y está libre.
---

<script is:inline>
  !(function (w, d) {
    // al navegar no se vuelve a iniciar: ya está la cola o la librería
    if (w.posthog) return;
    // cola hasta que llegue la librería
    var cola = (w.posthog = []);
    cola.__SV = 1;
    cola._i = [];
    cola.people = [];
    ["capture", "identify", "register", "reset"].forEach(function (metodo) {
      cola[metodo] = function () {
        cola.push([metodo].concat(Array.prototype.slice.call(arguments)));
      };
    });
    // en la cola, cada evento guarda su hora y no la de la librería
    cola.capture = function (evento, propiedades, opciones) {
      cola.push([
        "capture",
        evento,
        propiedades,
        Object.assign({ timestamp: new Date() }, opciones),
      ]);
    };
    cola.init = function (token, config, nombre) {
      cola._i.push([token, config, nombre]);
    };
    cola.init("phc_ekxNoB33yQfNQenOF0mgUN19Cz80AbjG36yQnMzd2aT", {
      api_host: "https://hog.comidolar.com.ar",
      ui_host: "https://us.posthog.com",
      // las visitas las registramos abajo: la librería puede llegar después
      // de que la persona ya navegó
      capture_pageview: false,
      capture_pageleave: true,
      // solo visitas y eventos propios: sin registrar clics
      autocapture: false,
      disable_session_recording: true,
      disable_surveys: true,
      disable_external_dependency_loading: true,
      advanced_disable_flags: true,
      capture_heatmaps: false,
      capture_dead_clicks: false,
      capture_performance: false,
      capture_exceptions: false,
    });
    // una vista por página, con su dirección, aunque quede en la cola
    d.addEventListener("astro:page-load", function () {
      w.posthog.capture("$pageview", {
        $current_url: location.href,
        $pathname: location.pathname,
      });
    });
    var cargar = function () {
      var s = d.createElement("script");
      s.async = true;
      s.crossOrigin = "anonymous";
      s.src = "https://hog.comidolar.com.ar/static/array.js";
      d.head.appendChild(s);
    };
    // apenas la página queda libre (tope 5 s): esperar más dejaba sin contar
    // a quien se va rápido
    var despues = function () {
      if (w.requestIdleCallback)
        w.requestIdleCallback(cargar, { timeout: 5000 });
      else setTimeout(cargar, 2000);
    };
    if (d.readyState === "complete") despues();
    else w.addEventListener("load", despues, { once: true });
  })(window, document);
</script>
