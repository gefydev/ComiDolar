---
import type AtroposSettings from "@/types/atropos";
const {
  customClass,
  customCss,
  settings,
}: {
  customClass?: string;
  customCss?: { [key: string]: string };
  settings?: AtroposSettings;
} = Astro.props;

const options: AtroposSettings = settings ?? {
  highlight: true,
  shadow: true,
  activeOffset: 30,
  rotateXMax: 15,
  rotateYMax: 15,
};
---

<div
  class={`atropos ${customClass || ""}`}
  data-atropos={JSON.stringify(options)}
>
  <div class="atropos-scale">
    <div class="atropos-rotate">
      <div class="atropos-inner" style={customCss}>
        <slot />
      </div>
    </div>
  </div>
</div>

<script>
  import Atropos from "atropos";

  const instances: ReturnType<typeof Atropos>[] = [];

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-atropos]").forEach((el) => {
      const instance = Atropos({
        el,
        ...JSON.parse(el.dataset.atropos ?? "{}"),
      });
      if (instance) instances.push(instance);
    });
  });

  // Cada instancia deja listeners en document y un requestAnimationFrame activo
  document.addEventListener("astro:before-swap", () => {
    instances.splice(0).forEach((instance) => instance.destroy());
  });
</script>
