---
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const secciones = [
  { href: "/", nombre: "Cotizaciones" },
  { href: "/calculadora", nombre: "Calculadora" },
  { href: "/blog", nombre: "Blog" },
  { href: "/futuro", nombre: "Tu Futuro" },
  { href: "/whatsapp", nombre: "Grupo" },
];
const actual = (href: string) =>
  href === "/" ? ruta === "/" : ruta === href || ruta.startsWith(href + "/");
---

<header class="top">
  {/* persiste al navegar: es siempre el mismo <img>, no se vuelve a bajar */}
  <a class="brand" href="/" transition:persist="marca">
    <img
      src="/assets/img/appicon_192.png"
      alt=""
      width="40"
      height="40"
      decoding="sync"
      fetchpriority="high"
    />
    comi.dolar
  </a>
  <nav class="pills" aria-label="Principal">
    {secciones.map(({ href, nombre }) => (
      <a href={href} aria-current={actual(href) ? "page" : undefined}>
        {nombre}
      </a>
    ))}
  </nav>
  <button class="btn" type="button" data-instalar hidden>
    Instalar
  </button>
</header>

<script>
  import "@/lib/instalar";

  // La sección actual tiene que quedar a la vista, sin mover la página.
  // after-swap: antes de que la transición fotografíe la página nueva.
  const mostrarActual = () => {
    const barra = document.querySelector(".pills");
    const actual = barra?.querySelector("[aria-current]");
    if (barra && actual)
      barra.scrollLeft +=
        actual.getBoundingClientRect().left -
        barra.getBoundingClientRect().left -
        (barra.clientWidth - actual.clientWidth) / 2;
  };
  document.addEventListener("astro:after-swap", mostrarActual);
  mostrarActual();

  // Con teclado, el navegador no desplaza un link que ya se ve a medias
  document.addEventListener("focusin", (e) => {
    const link = (e.target as Element).closest(".pills a");
    if (link?.matches(":focus-visible"))
      link.scrollIntoView({ block: "nearest", inline: "nearest" });
  });
</script>
