---
import AdSlot from "@/components/AdSlot.astro";
import Layout from "@/layouts/layout.astro";
import { PAYMENT_METHODS } from "@/db/payment.ts";
import Donantes from "@/components/Donantes.astro";
import PaymentMethod from "@/components/PaymentMethod.astro";

const descripcion =
  "Mostra tu apoyo a la Comisión de Dólar del Colegio Nacional de Buenos Aires (ComiDólar) dejando tu donación a voluntad. Sin obligación de compra. Proyecto sin fines de lucro.";
const metadata = {
  title: "Comi Dólar | Donaciones",
  description: { meta: descripcion, og: descripcion },
  canonical: "https://comidolar.com.ar/donaciones",
  og: { nombre: "donaciones" },
  migas: [["Donaciones", "/donaciones"]],
};
---

<Layout metadata={metadata}>
  <main class="pagina">
    <h1 class="h1">Donaciones</h1>
    <p class="mt-2 max-w-[68ch]">
      ComiDólar es un proyecto sin fines de lucro. Si te sirve, podés colaborar
      con lo que quieras.
    </p>
    <div class="grid gap-4 mt-4 lg:grid-cols-[1fr_320px] lg:items-start">
      <div class="grid gap-3 sm:grid-cols-2">
        {PAYMENT_METHODS.map((method) => (
          <PaymentMethod {...method} />
        ))}
      </div>
      <Donantes />
    </div>
    <AdSlot ubicacion="interna" />
  </main>
</Layout>
