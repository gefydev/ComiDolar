---
import type { PaymentMethodType } from "@/db/payment.ts";

const { name, image, pallete, cbu, alias, isWallet }: PaymentMethodType =
  Astro.props;
const datos = [
  { rotulo: isWallet ? "CVU" : "CBU", valor: cbu },
  { rotulo: "Alias", valor: alias },
];
---

<article class="caja" style={`border-color:${pallete.border}`}>
  <span class="sr-only" role="status" data-aviso></span>
  <h2 class="flex items-center gap-3 font-bold">
    <img
      class="w-10 h-10 rounded-full object-contain bg-white p-0.5"
      src={image}
      alt=""
      width="40"
      height="40"
    />
    {name}
  </h2>
  {datos.map(({ rotulo, valor }) => (
    <div class="flex items-center justify-between gap-2 mt-2">
      <p class="min-w-0 break-all">
        <span class="note block">{rotulo}</span>
        {valor}
      </p>
      <button
        class="btn"
        type="button"
        data-copiar={valor}
        aria-label={`Copiar ${rotulo} de ${name}`}
      >
        Copiar
      </button>
    </div>
  ))}
</article>

<script>
  // Un solo listener para todo el documento: sigue andando al navegar
  document.addEventListener("click", async (e) => {
    const boton = (e.target as Element).closest<HTMLElement>("[data-copiar]");
    if (!boton) return;
    const aviso = boton.closest("article")?.querySelector("[data-aviso]");
    try {
      await navigator.clipboard.writeText(boton.dataset.copiar ?? "");
      boton.textContent = "Copiado ✓";
    } catch {
      boton.textContent = "No se pudo";
    }
    // el nombre del botón es fijo: el resultado se anuncia aparte
    if (aviso) aviso.textContent = boton.textContent;
    setTimeout(() => (boton.textContent = "Copiar"), 2000);
  });
</script>
