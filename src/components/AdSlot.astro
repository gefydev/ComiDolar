---
// Espacio de publicidad con alto reservado (diseno-spec.md §4): 250 px, 90 px
// desde 900 px, para que sin anuncio o sin script no se mueva nada.
// La unidad es responsive: si AdSense sirve algo más alto, el espacio crece
// (recortar un anuncio va contra sus políticas).
import { EDITOR, UBICACIONES, type Ubicacion } from "@/config/anuncios";

const { ubicacion }: { ubicacion: Ubicacion } = Astro.props;
---

<aside class="ad" aria-label="Publicidad" data-ubicacion={ubicacion}>
  <span>Publicidad</span>
  <div class="ad-slot">
    <ins
      class="adsbygoogle"
      data-ad-client={EDITOR}
      data-ad-slot={UBICACIONES[ubicacion]}
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
  </div>
</aside>
