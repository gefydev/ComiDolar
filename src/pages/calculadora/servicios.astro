---
import Anuncio from "@/components/Anuncio.astro";
import Layout from "@/layouts/layout.astro";
import { digitalServices } from "@/db/digitalServices";

const metadata = {
  title: "Comi Dólar | Lista de servicios digitales",
  description: {
    meta: "Lista completa de los servicios digitales alcanzado por el IVA a Servicios digitales (21%) en pagos al exterior con tarjeta. Datos impuestos por la Resolución General N° 4240/2018 de AFIP.",
    og: "Lista completa de los servicios digitales alcanzado por el IVA a Servicios digitales (21%) en pagos al exterior con tarjeta. Datos impuestos por la Resolución General N° 4240/2018 de AFIP.",
  },
  canonical: "https://comidolar.com.ar/calculadora/servicios",
  og: {
    image: "https://comidolar.com.ar/assets/img/opengraph/servicios.webp",
    video: "https://comidolar.com.ar/assets/img/opengraph/video.webm",
  },
};
---

<Layout metadata={metadata}>
  <main class="pagina angosta">
    <h1 class="h1">Lista de Servicios Digitales AFIP</h1>
    <p class="mt-2">
      Esta página contiene la lista completa de los servicios digitales
      alcanzado por el IVA a Servicios digitales (21%) en pagos al exterior con
      tarjeta.
    </p>
    <p class="mt-2">
      Datos impuestos por la{" "}
      <a
        target="_blank"
        referrerpolicy="no-referrer"
        href="https://www.afip.gob.ar/iva/servicios-digitales/concepto.asp"
      >
        Resolución General N° 4240/2018 de AFIP
      </a>
      .
    </p>
    <Anuncio slot="detalle" />
    <input
      class="campo mt-4"
      type="search"
      placeholder="Buscar un servicio…"
      aria-label="Buscar un servicio"
      data-buscar-servicio
    />
    <p class="note mt-2" role="status" data-cuantos>
      {digitalServices.length} servicios
    </p>
    <ul class="mt-2" data-servicios>
      {digitalServices.map((service) => (
        <li class="py-2 border-b border-[var(--hair)]">{service}</li>
      ))}
    </ul>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const campo = document.querySelector<HTMLInputElement>(
      "[data-buscar-servicio]",
    );
    const cuantos = document.querySelector("[data-cuantos]");
    const filas = document.querySelectorAll<HTMLElement>("[data-servicios] li");
    campo?.addEventListener("input", () => {
      const texto = campo.value.trim().toLowerCase();
      let visibles = 0;
      for (const fila of filas) {
        fila.hidden = !fila.textContent!.toLowerCase().includes(texto);
        if (!fila.hidden) visibles++;
      }
      cuantos!.textContent = `${visibles} servicios`;
    });
  });
</script>
