---
import type { Cotizaciones } from "@/lib/cotizaciones";
import { textoEstado } from "@/lib/estado";

const {
  cotizaciones,
  clase = "note",
}: { cotizaciones: Cotizaciones | null; clase?: string } = Astro.props;
---

<p data-estado-cotizaciones role="status" class={clase}>
  {textoEstado(cotizaciones, false)}
</p>
<script
  type="application/json"
  data-cotizaciones
  set:html={JSON.stringify(cotizaciones)}
/>
